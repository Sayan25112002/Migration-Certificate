            <textField>
                <reportElement x="10" y="206" width="534" height="108" uuid="baf2ae62-cbef-4232-b8c2-5d861f071a39">
                    <property name="com.jaspersoft.layout.grid.x" value="0"/>
                    <property name="com.jaspersoft.layout.grid.y" value="-1"/>
                    <property name="com.jaspersoft.layout.grid.weight.x" value="1.0"/>
                    <property name="com.jaspersoft.layout.grid.weight.y" value="1.0"/>
                    <property name="com.jaspersoft.layout.grid.rowspan" value="1"/>
                    <property name="com.jaspersoft.layout.grid.colspan" value="2"/>
                    <property name="com.jaspersoft.layout.grid.weight.fixed" value="false"/>
                </reportElement>
                <box topPadding="5"/>
                <textElement markup="html">
                    <font fontName="NotoSansDevanagari" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["यह प्रमाणित किया जाता है कि श्री/सुश्री/श्रीमती- "+$P{data}.get("naam")+" (पिता: "+$P{data}.get("papaKaNaam")+", माता: -"+$P{data}.get("maaKaNaam")+", आवेदन संख्या: - "+$P{data}.get("applicationNumber")+", नामांकन संख्या: "+$P{data}.get("enrollmentNumber")+") ने "+$P{data}.get("year")+" में आयोजित "+$P{data}.get("shiksha")+" शिक्षा में भाग लिया और परीक्षा उत्तीर्ण की।<br/><br />किसी अन्य संस्था/विश्वविद्यालय में प्रवेश लेने/परीक्षा में सम्मिलित होने से इस विश्वविद्यालय को कोई आपत्ति नहीं है"
]]></textFieldExpression>
            </textField>
