                    <font fontName="NotoSansDevanagari" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["यह प्रमाणित किया जाता है कि श्री/सुश्री/श्रीमती- "+$P{data}.get("naam")+" (पिता - "+$P{data}.get("papaKaNaam")+", माता - "+$P{data}.get("maaKaNaam")+", आवेदन संख्या - "+$P{data}.get("applicationNumber")+", नामांकन संख्या - "+$P{data}.get("enrollmentNumber")+") ने "+$P{data}.get("year")+" में आयोजित "+$P{data}.get("shiksha")+" शिक्षा में भाग लिया और परीक्षा उत्तीर्ण की।<br /><br />किसी अन्य संस्था/विश्वविद्यालय में प्रवेश लेने/परीक्षा में सम्मिलित होने से इस विश्वविद्यालय को कोई आपत्ति नहीं है।"]]></textFieldExpression>
            </textField>
