                <box topPadding="5" leftPadding="0"/>
                <textElement textAlignment="Left" markup="html">
                    <font fontName="Times New Roman" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["This is to certify that Mr./Ms./Mrs. "+$P{data}.get("name")+", Son/Daughter/wife of Shri "+$P{data}.get("fatherName")+" & Mother Name - "+$P{data}.get("motherName")+", Application No - "+$P{data}.get("applicationNumber")+" , Enrolment No - "+$P{data}.get("enrollmentNumber")+" has appeared in  "+$P{data}.get("course")+" held in "+$P{data}.get("year")+" with He/she has PASS the examination.<br/><br />The University has no objection on his/her joining or appearing in examination of any other recognized University/Institution."]]></textFieldExpression>
            </textField>
